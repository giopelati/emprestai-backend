{
  "name": "@emprestai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node scripts/jest.mjs"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/dist-test/test/**/*.test.js"
    ],
    "transform": {},
    "testTimeout": 60000,
    "verbose": true
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "jest": "30.5.2",
    "typescript": "5.9.3"
  }
}
